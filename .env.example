# 复制本文件为 .env
# API Key 不再写在此处，请在 Web 管理端「控制台 → 模型设置」页面填写
# Key 会被加密存储在 data/settings.db 中

# API 地址（默认值，Web 页面保存后覆盖）
LLM_BASE_URL=https://api.deepseek.com

# 模型名称（默认值，Web 页面保存后覆盖）
LLM_MODEL=deepseek-chat

# 中文向量模型（本地运行，首次运行会自动下载，约 100MB；与 LLM API 无关）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---------- 检索策略（可选，均有默认值） ----------
# CAG 模式：知识库较小时跳过检索，全文直接进上下文
# CAG_TOKEN_THRESHOLD=80000   # 总字数上限
# CAG_MAX_CHUNKS=1000         # 片段数上限
# 混合检索：BM25 关键词 + 向量双路召回，RRF 融合；设为 false 退回纯向量
# HYBRID_SEARCH_ENABLED=true
# VECTOR_TOP_K=20             # 向量召回数量
# BM25_TOP_K=20               # BM25 召回数量
# RRF_K=60                    # RRF 融合常数
# FINAL_TOP_K=3               # 最终返回给模型的片段数

# 以下由系统自动生成，请勿手动修改
# JWT_SECRET=...
# ENCRYPTION_KEY=...

# HuggingFace 离线模式：模型已缓存本地时跳过启动联网校验（避免首次加载卡几分钟）
HF_HUB_OFFLINE=1
# 首次下载新模型时：临时注释上面这行，或改用镜像 HF_ENDPOINT=https://hf-mirror.com
