# 复制本文件为 .env
# API Key 不再写在此处，请在 Web 管理端「控制台 → 模型设置」页面填写
# Key 会被加密存储在 data/settings.db 中

# API 地址（默认值，Web 页面保存后覆盖）
LLM_BASE_URL=https://api.deepseek.com

# 模型名称（默认值，Web 页面保存后覆盖）
LLM_MODEL=deepseek-chat

# 中文向量模型（本地运行，首次运行会自动下载，约 100MB；与 LLM API 无关）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 以下由系统自动生成，请勿手动修改
# JWT_SECRET=...
# ENCRYPTION_KEY=...
